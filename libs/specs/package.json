{
	"name": "@backoffice/specs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "index.js",
	"types": "index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		},
		"./package.json": "./package.json"
	},
