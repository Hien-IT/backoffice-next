{
	"name": "@backoffice/utils",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/shared/index.d.ts",
			"default": "./dist/shared/index.js"
		},
		"./node": {
			"types": "./dist/node/index.d.ts",
			"default": "./dist/node/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.lib.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"lint": "eslint src"
	},
	"dependencies": {
		"@backoffice/constants": "workspace:*",
		"@backoffice/errors": "workspace:*",
		"@backoffice/system-data": "workspace:*",
		"@backoffice/types": "workspace:*",
		"date-fns": "catalog:",
		"joi": "catalog:",
		"js-yaml": "catalog:",
		"knex": "catalog:",
		"lodash-es": "catalog:",
		"micromustache": "catalog:"
	},
	"devDependencies": {
		"@backoffice/schema-builder": "workspace:*",
		"@ngneat/falso": "catalog:",
		"@types/js-yaml": "catalog:",
		"@types/lodash-es": "catalog:"
	}
}
