		"@shopify/semaphore": "catalog:",
		"@smithy/node-http-handler": "catalog:",
		"@tus/utils": "catalog:",
		"ms": "catalog:"
	},
	"devDependencies": {
		"@backoffice/types": "workspace:*",
		"@ngneat/falso": "catalog:",
		"@types/ms": "catalog:"
