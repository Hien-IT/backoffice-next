{
	"name": "web",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/web/src",
	"targets": {
		"sync-translations": {
			"command": "node scripts/sync-translations.mjs",
			"options": {
				"cwd": "apps/web"
			},
			"cache": false
		},
		"sync-themes": {
			"command": "../../node_modules/.bin/jiti scripts/sync-directus-themes.mjs",
			"options": {
				"cwd": "apps/web"
			},
			"cache": false
		},
		"fixtures": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/web",
				"commands": ["node fixtures/interfaces/seed.mjs", "node fixtures/interfaces/export.mjs"],
				"parallel": false
			},
			"cache": false
		},
		"check-bundle": {
			"command": "node scripts/check-bundle.mjs",
			"options": {
				"cwd": "apps/web"
			},
			"dependsOn": ["build"]
		}
	}
}
