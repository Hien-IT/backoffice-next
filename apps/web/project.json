{
	"name": "web",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/web/src",
	"targets": {
		"sync-translations": {
			"command": "node scripts/sync-translations.mjs",
			"options": {
				"cwd": "apps/web"
			},
			"cache": false
		},
		"check-bundle": {
			"command": "node scripts/check-bundle.mjs",
			"options": {
				"cwd": "apps/web"
			},
			"dependsOn": ["build"]
		}
	}
}
