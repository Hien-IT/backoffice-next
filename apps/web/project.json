{
	"name": "web",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/web/src",
	"targets": {
		"sync-translations": {
			"command": "node scripts/sync-translations.mjs",
			"options": {
				"cwd": "apps/web"
			},
			"cache": false
		},
		"sync-themes": {
			"command": "node_modules/.bin/jiti scripts/sync-theme-presets.mjs",
			"options": {
				"cwd": "apps/web"
			},
			"cache": false
		},
		"sync-permissions-data": {
			"command": "node_modules/.bin/jiti scripts/sync-permissions-data.mjs",
			"options": {
				"cwd": "apps/web"
			},
			"cache": false
		},
		"fixtures": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/web",
				"commands": ["node fixtures/interfaces/seed.mjs", "node fixtures/interfaces/export.mjs"],
				"parallel": false
			},
			"cache": false
		},
		"check-bundle": {
			"command": "node scripts/check-bundle.mjs",
			"options": {
				"cwd": "apps/web"
			},
			"dependsOn": ["build"]
		},
		"container": {
			"executor": "@nx-tools/nx-container:build",
			"options": {
				"engine": "docker",
				"context": ".",
				"file": "apps/web/Dockerfile",
				"platforms": ["linux/amd64"],
				"load": true,
				"tags": ["hiennd23/backoffice-web:local"]
			},
			"cache": false
		}
	}
}
