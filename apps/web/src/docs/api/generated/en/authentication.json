									"message": {
										"type": "string"
									}
								}
							}
						}
					}
				}
			],
			"rest": "curl -X POST \"https://backoffice.example.com/auth/refresh\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"refresh_token\":\"eyJ0eXAiOiJKV...\"}'",
			"graphql": "# POST /graphql/system\nmutation {\n  auth_refresh(refresh_token: \"<refresh-token>\", mode: json) {\n    access_token\n    refresh_token\n    expires\n  }\n}",
			"responseExample": {
				"data": {
					"access_token": "eyJhbGciOiJI...",
					"expires": 900,
					"refresh_token": "Gy-caJMpmGTA..."
				}
			},
			"backofficeOnly": false,
			"anchor": "refresh-token"
		},
		{
