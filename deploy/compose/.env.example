# One env file for Directus and Backoffice (spec 019 FR-041): both services read it as is, like envFrom on Kubernetes.
# ./init-env.sh copies it to .env and fills the empty secrets with random values.
PUBLIC_URL=http://localhost:8090
SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

DB_CLIENT=pg
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=

# Required for several instances (spec "Env Directus bắt buộc khi chạy nhiều instance").
REDIS=redis://redis:6379
CACHE_ENABLED=true
CACHE_STORE=redis
CACHE_AUTO_PURGE=true
RATE_LIMITER_ENABLED=false
RATE_LIMITER_STORE=redis
SYNCHRONIZATION_STORE=redis

STORAGE_LOCATIONS=s3
STORAGE_S3_DRIVER=s3
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
STORAGE_S3_BUCKET=directus
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_FORCE_PATH_STYLE=true

TUS_ENABLED=true
WEBSOCKETS_ENABLED=false
