# Feature 002 (US4, SC-004): own namespaces for every shared Redis structure, and a short schema sync timeout so
# the stuck-lock case of build-once.test.ts takes seconds. Test values only.
CACHE_NAMESPACE=parity-cache-config
REDIS_BUS_NAMESPACE=parity:bus
REDIS_LOCK_NAMESPACE=parity:lock
REDIS_PERMISSIONS_NAMESPACE=parity-permissions
CACHE_SCHEMA_SYNC_TIMEOUT=1000
# No response cache: its Redis reads would hang Directus while Redis is down (schema/redis-down). The response cache
# with Redis down is measured on the cache-redis pair, which has its own Redis (feature 005, FR-016).
CACHE_ENABLED=false
