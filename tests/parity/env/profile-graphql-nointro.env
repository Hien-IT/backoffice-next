# Profile graphql-nointro (feature 011, research R9, FR-060): introspection off, a 50-token document limit, a two-entry
# schema cache and one schema generation at a time, so schema.test.ts and errors.test.ts can see those limits
# (they are read at start-up). Same DB, Redis, bus and namespaces as the main pair. Test values only.
CACHE_NAMESPACE=parity-graphql-nointro
GRAPHQL_INTROSPECTION=false
GRAPHQL_QUERY_TOKEN_LIMIT=50
GRAPHQL_SCHEMA_CACHE_CAPACITY=2
GRAPHQL_SCHEMA_GENERATION_MAX_CONCURRENT=1
