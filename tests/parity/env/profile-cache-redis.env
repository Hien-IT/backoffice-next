# Profile cache-redis (feature 005, research R5, R9): Redis store without auto purge, on its own Redis (service
# redis-cache) so redis-down.test.ts can stop it without touching the other pairs (FR-016, T033). WebSockets on (the
# Directus blackbox runs with them on too) so the websocket.event bridge is registered for the R-10 case (T044).
# CACHE_VALUE_MAX_SIZE is low for the FR-042 case. See profile-cache-mem.env. Test values only.
REDIS=redis://redis-cache:6379
CACHE_ENABLED=true
CACHE_STORE=redis
CACHE_AUTO_PURGE=false
CACHE_STATUS_HEADER=x-cache-status
CACHE_SKIP_ALLOWED=false
CACHE_VALUE_MAX_SIZE=1kb
CACHE_AUTO_PURGE_IGNORE_LIST=directus_activity,directus_presets,test_cache_ignored
CACHE_NAMESPACE=parity-cache-redis
REDIS_BUS_NAMESPACE=parity-cache-redis:bus
REDIS_LOCK_NAMESPACE=parity-cache-redis:lock
REDIS_PERMISSIONS_NAMESPACE=parity-cache-redis-permissions
WEBSOCKETS_ENABLED=true
WEBSOCKETS_REST_ENABLED=true
