# Profile retention (feature 008, research R5, contracts/parity.md §1): the history retention job every 10 s (six-field
# cron) with timeframes of seconds. This pair shares the parity database and deletes the history of every other suite,
# so only src/history/retention.test.ts brings it up (profileUp) and stops it (profileStop); never list it in
# `env-up --profiles`. Its own bus and lock: the two apps of the pair share the `schedule--data-retention` lock with each
# other only. Test values only.
CACHE_NAMESPACE=parity-retention
REDIS_BUS_NAMESPACE=parity-retention:bus
REDIS_LOCK_NAMESPACE=parity-retention:lock
SYNCHRONIZATION_STORE=redis
SYNCHRONIZATION_NAMESPACE=parity-retention:sync
RETENTION_ENABLED=true
RETENTION_SCHEDULE=*/10 * * * * *
RETENTION_BATCH=3
ACTIVITY_RETENTION=2s
REVISIONS_RETENTION=1s
FLOW_LOGS_RETENTION=2s
