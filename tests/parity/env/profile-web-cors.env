# Profile web (feature 012, research R10, FR-071 configuration 3): the new API on another site than the web app
# (backoffice-web-cors at http://localhost:8181 calls http://127.0.0.1:8163), so the session and refresh cookies need
# SameSite=None; Secure (Chromium treats both hosts as secure contexts, research R3). Same DB as the main
# pair; its own cache, bus and lock namespaces. A 30 s access token lets the E2E see a refresh in CI time (SC-004,
# CHK047). Only the new API reads this file (no Directus in this pair). Test values only.
CACHE_NAMESPACE=parity-web-cors
REDIS_BUS_NAMESPACE=parity-web-cors:bus
REDIS_LOCK_NAMESPACE=parity-web-cors:lock
PUBLIC_URL=http://127.0.0.1:8163
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:8181
CORS_CREDENTIALS=true
SESSION_COOKIE_SAME_SITE=None
SESSION_COOKIE_SECURE=true
REFRESH_TOKEN_COOKIE_SAME_SITE=None
REFRESH_TOKEN_COOKIE_SECURE=true
ACCESS_TOKEN_TTL=30s
# Like the blackbox pair: on a loaded CI runner the pressure limiter answers 503 "Under pressure" (CI 7d2bb84).
PRESSURE_LIMITER_ENABLED=false
