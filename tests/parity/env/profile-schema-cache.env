# Profile schema-cache (feature 006, research R7): the two nodes of "schema change propagates across nodes using
# messenger" of directus/tests/blackbox/tests/db/routes/collections/schema-cache.test.ts, with the env that file gives
# them (memory cache with auto purge, schema cache on, Redis bus). Own bus, lock and permissions namespaces so this pair
# only hears its own schemaChanged messages. The Backoffice node overrides CACHE_NAMESPACE (+ '2') in compose, like the
# second node of the original. Read after env/<vendor>.env and env/profile-blackbox.env. Test values only.
CACHE_ENABLED=true
CACHE_AUTO_PURGE=true
CACHE_SCHEMA=true
CACHE_STORE=memory
CACHE_NAMESPACE=directus-schema-cache
REDIS_ENABLED=true
SYNCHRONIZATION_STORE=redis
REDIS_BUS_NAMESPACE=parity-schema-cache:bus
REDIS_LOCK_NAMESPACE=parity-schema-cache:lock
REDIS_PERMISSIONS_NAMESPACE=parity-schema-cache-permissions
