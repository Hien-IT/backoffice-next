# Profile schema-cache-nomsg (feature 006, research R7): the two nodes of "schema change does not propagate across nodes
# without messenger" of schema-cache.test.ts. Redis disabled (REDIS_ENABLED=false wins over REDIS of the vendor env), so
# each node keeps its schema in memory and nothing is shared. The Backoffice node overrides CACHE_NAMESPACE (3 → 4) in
# compose. The test restarts both containers first, like the fresh processes of the original. Test values only.
CACHE_ENABLED=true
CACHE_AUTO_PURGE=true
CACHE_SCHEMA=true
CACHE_STORE=memory
CACHE_NAMESPACE=directus-schema-cache3
REDIS_ENABLED=false
SYNCHRONIZATION_STORE=memory
RATE_LIMITER_STORE=memory
