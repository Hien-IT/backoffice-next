# Profile setup (feature 010, research R11, contracts/parity.md §3): POST /server/setup needs a database without any
# directus_users row, so this pair has its own Postgres (postgres-setup) and never touches the shared parity database.
# ADMIN_EMAIL and ADMIN_PASSWORD are empty, so the bootstrap of the Directus image creates the Administrator role and
# policy but no user (createAdmin returns early). Redis db 9 keeps every cache, lock, permissions and sync key of this
# pair away from the main pair; pub/sub ignores the db number, so the bus needs its own namespace (otherwise the schema
# of this empty database reaches the main pair, R-19, and its flows reload). Postgres only (env/postgres.env first).
# Test values only.
DB_HOST=postgres-setup
ADMIN_EMAIL=
ADMIN_PASSWORD=
REDIS=redis://redis:6379/9
PUBLIC_URL=http://localhost:10455
CACHE_NAMESPACE=parity-setup
REDIS_BUS_NAMESPACE=parity-setup:bus
REDIS_LOCK_NAMESPACE=parity-setup:lock
# Feature 012 (T059): the web app at http://localhost:8181 runs /setup against this pair from another site.
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:8181
CORS_CREDENTIALS=true
SESSION_COOKIE_SAME_SITE=None
SESSION_COOKIE_SECURE=true
