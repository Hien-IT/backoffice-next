# Profile cache-mem (feature 005, research R5): the first of the four response cache configurations of the Directus
# blackbox cache.test.ts (memory store, no auto purge). Own namespaces for every shared Redis structure, like
# cache-config (002), so this pair never shares a bus, a lock or a permissions cache with the main pair: fixtures of
# this pair are made through its own Directus. CACHE_SKIP_ALLOWED overrides the main env (true from T037).
# Test values only.
CACHE_ENABLED=true
CACHE_STORE=memory
CACHE_AUTO_PURGE=false
CACHE_STATUS_HEADER=x-cache-status
CACHE_SKIP_ALLOWED=false
CACHE_AUTO_PURGE_IGNORE_LIST=directus_activity,directus_presets,test_cache_ignored
CACHE_NAMESPACE=parity-cache-mem
REDIS_BUS_NAMESPACE=parity-cache-mem:bus
REDIS_LOCK_NAMESPACE=parity-cache-mem:lock
REDIS_PERMISSIONS_NAMESPACE=parity-cache-mem-permissions
