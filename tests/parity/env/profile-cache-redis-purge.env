# Profile cache-redis-purge (feature 005, research R5): Redis store with auto purge. See profile-cache-mem.env.
# Test values only.
CACHE_ENABLED=true
CACHE_STORE=redis
CACHE_AUTO_PURGE=true
CACHE_STATUS_HEADER=x-cache-status
CACHE_SKIP_ALLOWED=false
CACHE_AUTO_PURGE_IGNORE_LIST=directus_activity,directus_presets,test_cache_ignored
CACHE_NAMESPACE=parity-cache-redis-purge
REDIS_BUS_NAMESPACE=parity-cache-redis-purge:bus
REDIS_LOCK_NAMESPACE=parity-cache-redis-purge:lock
REDIS_PERMISSIONS_NAMESPACE=parity-cache-redis-purge-permissions
