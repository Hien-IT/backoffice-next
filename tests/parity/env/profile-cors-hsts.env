# Profile cors-hsts (T065): CORS, HSTS, a custom robots.txt and no root redirect.
CACHE_NAMESPACE=parity-cors-hsts
CORS_ENABLED=true
CORS_ORIGIN=true
HSTS_ENABLED=true
ROBOTS_TXT=User-agent: parity
ROOT_REDIRECT=false
# Feature 007 (FR-050): TUS on, to compare OPTIONS /files/tus* while the CORS middleware answers every OPTIONS.
TUS_ENABLED=true
# Feature 007 (FR-052): S3 first, so the TUS uploads of this pair go to MinIO (TUS uses the first location).
STORAGE_LOCATIONS=s3,local
