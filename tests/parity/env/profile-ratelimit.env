# Profile ratelimit (T065): IP and global rate limiters on Redis, health thresholds of the limiters very low (warn).
CACHE_NAMESPACE=parity-ratelimit
RATE_LIMITER_ENABLED=true
RATE_LIMITER_STORE=redis
RATE_LIMITER_POINTS=10
RATE_LIMITER_DURATION=60
RATE_LIMITER_GLOBAL_ENABLED=true
RATE_LIMITER_GLOBAL_POINTS=100000
RATE_LIMITER_GLOBAL_DURATION=1
RATE_LIMITER_HEALTHCHECK_THRESHOLD=0.001
RATE_LIMITER_GLOBAL_HEALTHCHECK_THRESHOLD=0.001
