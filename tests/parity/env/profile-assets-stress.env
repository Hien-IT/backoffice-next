# Profile assets-stress (feature 007, research R8): read after env/profile-blackbox.env. Only the time-dependent
# cases, kept apart so the blackbox files never see them: one transformation at a time, a 100 ms transformation
# timeout, TUS uploads that expire after 2 s with a cleanup every minute. ASSETS_CACHE_TTL=1h makes it the default
# node of the blackbox cache-revalidate.test.ts too (raw assets only, no transformation). Test values only.
CACHE_NAMESPACE=parity-assets-stress
ASSETS_TRANSFORM_MAX_CONCURRENT=1
ASSETS_TRANSFORM_TIMEOUT=100ms
ASSETS_CACHE_TTL=1h
CORS_ENABLED=false
TUS_UPLOAD_EXPIRATION=2s
TUS_CLEANUP_SCHEDULE=* * * * *
SYNCHRONIZATION_STORE=redis
# Its own bus and lock (feature 007): the TUS cleanup above calls getSchema() every minute, and a schema build that
# starts before a schema change at the main pair is handed, stale, to every process waiting on the shared
# `schemaCache--preparing` lock (R-19). The tests on this pair change no schema, so it needs no `schemaChanged`.
REDIS_BUS_NAMESPACE=parity-assets-stress:bus
REDIS_LOCK_NAMESPACE=parity-assets-stress:lock
