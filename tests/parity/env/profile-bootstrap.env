# Profile bootstrap (spec 021, contracts/tests.md): Directus 11.17.4 and Backoffice each bootstrap an empty database
# (Postgres postgres-bootstrap, or a SQLite file under .data/bootstrap) with the same values, then the databases are
# compared. Read after env/<vendor>.env; the per-database values (DB, PUBLIC_URL, Redis db, namespaces,
# MIGRATIONS_PATH) are in the `environment` of each service. Test values only, not secrets.
DB_HOST=postgres-bootstrap
# Distinct values, so the secret check (spec FR-016) never matches an ordinary word of a log line.
DB_PASSWORD=bootstrap-db-pass-91c2
ADMIN_PASSWORD=bootstrap-admin-pass-7f3a
PROJECT_NAME=Bootstrap Parity
PROJECT_OWNER=owner-bootstrap@example.com
ADMIN_TOKEN=bootstrap-admin-token-0123456789
KEY=5b1d3f8e-1c2a-4e7b-9a0d-6f4e2c8b1a37
LOG_STYLE=raw
# The owner reports of this profile go to its own test registry, so their count belongs to this profile only.
COMPLIANCE_URL=http://registry-bootstrap:9100
CACHE_ENABLED=true
CACHE_STORE=redis
CACHE_STATUS_HEADER=x-cache-status
