# Profile blackbox (feature 005, research R6): the pair the port of the Directus blackbox items, query and relational
# files runs against. The assertions of that suite depend on the env of directus/tests/blackbox/common/config.ts, so
# these values are copied from it (main instance: no response cache). Same Redis, bus and namespaces as the main pair:
# collections made through the main Directus are seen by this pair too. Test values only.
CACHE_ENABLED=false
MAX_BATCH_MUTATION=100
QUERY_LIMIT_DEFAULT=90
MAX_RELATIONAL_DEPTH=5
MAX_PAYLOAD_SIZE=10mb
# Feature 007: the rest of directus/tests/blackbox/common/config.ts that the files and assets files read. Without
# PRESSURE_LIMITER_ENABLED=false the 100 connections of concurrency.test.ts meet the pressure limiter (503) on CI.
ASSETS_TRANSFORM_MAX_CONCURRENT=2
TUS_ENABLED=true
PRESSURE_LIMITER_ENABLED=false
