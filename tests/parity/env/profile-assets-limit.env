# Profile assets-limit (feature 007, research R8): read after env/profile-blackbox.env. The revalidating node of the
# blackbox cache-revalidate.test.ts and the parity cases that need a narrower configuration than the main pair: MIME
# allow list, upload size limit, TUS with the default expiration, synchronized cleanup clock in Redis. Test values only.
CACHE_NAMESPACE=parity-assets-limit
ASSETS_CACHE_REVALIDATE=true
CORS_ENABLED=false
FILES_MIME_TYPE_ALLOW_LIST=image/*,application/pdf
FILES_MAX_UPLOAD_SIZE=30mb
SYNCHRONIZATION_STORE=redis
