# Feature 020 (contracts/tests.md §3): the extensions pair for install, reinstall, uninstall, limits and the schedule hook.
# Its own prefix on the shared storage, so installing here never changes what the main pair loads.
EXTENSIONS_LOCATION=s3
EXTENSIONS_PATH=./extensions-ext
EXTENSIONS_LIMIT=3
MARKETPLACE_TRUST=sandbox
BO_EXT_SCHEDULE=1
CACHE_NAMESPACE=directus-extensions
# The schedule hook runs once per tick across the pair (shared lock <extension>:<index>, like Directus with Redis).
SYNCHRONIZATION_STORE=redis
SYNCHRONIZATION_NAMESPACE=parity-extensions:sync
