# One config for BOTH apps (SC-001): Directus 11.17.4 and Backoffice read this same file.
# Test values only, not secrets.
PUBLIC_URL=http://localhost:8155
SECRET=parity-test-secret-0123456789abcdef
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
TELEMETRY=false

DB_CLIENT=sqlite3
DB_FILENAME=/directus/database/sqlite/data.db

REDIS=redis://redis:6379
CACHE_ENABLED=true
CACHE_STORE=redis
CACHE_AUTO_PURGE=true
# Feature 005 (research R4): the parity requests send Cache-Control: no-store and compare the cache status.
CACHE_SKIP_ALLOWED=true
CACHE_STATUS_HEADER=x-cache-status
RATE_LIMITER_ENABLED=false
RATE_LIMITER_STORE=redis

# Feature 007 (research R6): `local` first (the default location of uploads and TUS, as in the Directus blackbox), on
# the named volume `uploads` that every app container mounts, then MinIO.
STORAGE_LOCATIONS=local,s3
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
STORAGE_S3_DRIVER=s3
STORAGE_S3_KEY=minioadmin
STORAGE_S3_SECRET=minioadmin
STORAGE_S3_BUCKET=directus
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_FORCE_PATH_STYLE=true

WEBSOCKETS_ENABLED=false
# Feature 009 (logs.test.ts): one variable exposed to flows as $env, so the run logs redact its value. Test values only.
FLOWS_ENV_ALLOW_LIST=PARITY_FLOWS_ENV_TEST
PARITY_FLOWS_ENV_TEST=parity-env-secret
# Feature 010 (research R12): the test extensions registry of docker-compose.yml, never the real one.
MARKETPLACE_REGISTRY=http://registry:9100
