{
	"name": "parity-hook-sandbox",
	"version": "1.0.0",
	"type": "module",
	"directus:extension": {
		"type": "hook",
		"path": "dist/index.js",
		"source": "src/index.js",
		"host": "^11.0.0",
		"sandbox": {
			"enabled": true,
			"requestedScopes": {
				"request": {
					"urls": [
						"http://files-fixtures/*",
						"http://127.0.0.1:8882/*"
					],
					"methods": [
						"GET"
					]
				},
				"log": {},
				"sleep": {}
			}
		}
	}
}
