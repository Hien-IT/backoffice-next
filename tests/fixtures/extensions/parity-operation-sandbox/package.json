{
	"name": "parity-operation-sandbox",
	"version": "1.0.0",
	"type": "module",
	"directus:extension": {
		"type": "operation",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"source": {
			"app": "src/app.js",
			"api": "src/api.js"
		},
		"host": "^11.0.0",
		"sandbox": {
			"enabled": true,
			"requestedScopes": {
				"request": {
					"urls": [
						"http://files-fixtures/*",
						"http://127.0.0.1:8882/*"
					],
					"methods": [
						"GET"
					]
				},
				"log": {},
				"sleep": {}
			}
		}
	}
}
