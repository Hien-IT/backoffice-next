{
	"name": "benchmark",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"targets": {
		"env-up": {
			"executor": "nx:run-commands",
			"options": {
				"command": "docker compose -p benchmark -f docker-compose.yml --profile postgres up -d --build --wait",
				"cwd": "tests/benchmark"
			}
		},
		"env-down": {
			"executor": "nx:run-commands",
			"options": {
				"command": "docker compose -p benchmark -f docker-compose.yml --profile postgres --profile bench-web down -v --remove-orphans",
				"cwd": "tests/benchmark"
			}
		},
		"env-up-auth": {
			"executor": "nx:run-commands",
			"options": {
				"command": "docker compose -p benchmark -f docker-compose.yml -f auth.compose.yml --profile postgres up -d --build --wait",
				"cwd": "tests/benchmark"
			}
		},
		"env-up-web": {
			"executor": "nx:run-commands",
			"options": {
				"command": "docker compose -p benchmark -f docker-compose.yml --profile postgres --profile bench-web up -d --build --wait",
				"cwd": "tests/benchmark"
			}
		},
		"run": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node src/run.ts",
				"cwd": "tests/benchmark"
			},
			"cache": false
		},
		"auth": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node src/auth.ts",
				"cwd": "tests/benchmark"
			},
			"cache": false
		},
		"permissions": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node src/permissions.ts",
				"cwd": "tests/benchmark"
			},
			"cache": false
		},
		"items": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node src/items.ts",
				"cwd": "tests/benchmark"
			},
			"cache": false
		},
		"files": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node src/files.ts",
				"cwd": "tests/benchmark"
			},
			"cache": false
		},
		"schema": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node src/schema.ts",
				"cwd": "tests/benchmark"
			},
			"cache": false
		},
		"history": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node src/history.ts",
				"cwd": "tests/benchmark"
			},
			"cache": false
		},
		"flows": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node src/flows.ts",
				"cwd": "tests/benchmark"
			},
			"cache": false
		},
		"system": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node src/system.ts",
				"cwd": "tests/benchmark"
			},
			"cache": false
		},
		"graphql": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node src/graphql.ts",
				"cwd": "tests/benchmark"
			},
			"cache": false
		},
		"web": {
			"executor": "nx:run-commands",
